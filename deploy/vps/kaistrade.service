[Unit]
Description=KaisTrade backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kais
Group=kais
WorkingDirectory=/opt/kaistrade/backend
EnvironmentFile=/etc/kaistrade.env
# Durum bellekte tutulur: TEK süreç çalıştırılmalı (--workers kullanmayın).
ExecStart=/opt/kaistrade/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
